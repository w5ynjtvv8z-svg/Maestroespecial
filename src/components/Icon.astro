const isFill = name in fill;
const inner = isFill ? fill[name] : stroke[name] ?? stroke.tool;
---
<svg
  class={`icon ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width={isFill ? undefined : 1.8}
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={inner}
/>

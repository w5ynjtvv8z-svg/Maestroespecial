---
/**
 * Аналитика: Google Analytics 4 + Microsoft Clarity.
 * ID задаются в админке (Настройки сайта). Пока ID пустые — ничего не загружается.
 *
 * GDPR: по умолчанию согласие "denied" (Google Consent Mode v2).
 * Cookies включаются только после нажатия «Принять» в баннере.
 *
 * События, которые отправляются в GA4 (и Clarity):
 *   click_call       — нажатие на номер телефона
 *   click_whatsapp   — нажатие на WhatsApp
 *   click_social     — переход в Instagram / YouTube / TikTok
 *   click_cta        — прочие кнопки с data-track (например «Подробнее» по услуге)
 *   generate_lead    — отправлена форма заявки
 *   select_language  — переключение языка
 * У каждого события есть параметры: location (где на странице), page_lang, label.
 */
import { settings } from '../lib/data';
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ga4Id = settings.ga4Id?.trim();
const clarityId = settings.clarityId?.trim();
---
<script is:inline define:vars={{ ga4Id, clarityId, lang }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('consent', 'default', {
    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
    analytics_storage: 'denied', wait_for_update: 500,
  });

  var CONSENT_KEY = 'me-consent';
  function readConsent() { try { return localStorage.getItem(CONSENT_KEY); } catch (e) { return null; } }

  function loadClarity() {
    if (!clarityId || window.clarity) return;
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', clarityId);
  }

  // Вызывается баннером cookies
  window.meSetConsent = function (granted) {
    try { localStorage.setItem(CONSENT_KEY, granted ? 'granted' : 'denied'); } catch (e) {}
    gtag('consent', 'update', { analytics_storage: granted ? 'granted' : 'denied' });
    if (granted) loadClarity();
    else if (window.clarity) window.clarity('consent', false);
  };

  if (readConsent() === 'granted') {
    gtag('consent', 'update', { analytics_storage: 'granted' });
    loadClarity();
  }

  if (ga4Id) {
    gtag('js', new Date());
    gtag('config', ga4Id, { page_lang: lang });
    var s = document.createElement('script');
    s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
    document.head.appendChild(s);
  }

  // Единая функция отправки событий
  window.meTrack = function (name, params) {
    params = Object.assign({ page_lang: lang }, params || {});
    gtag('event', name, params);
    if (window.clarity) window.clarity('event', name);
  };

  // Автоматическое отслеживание кликов
  document.addEventListener('click', function (e) {
    var el = e.target.closest && e.target.closest('a, button');
    if (!el) return;
    var href = el.getAttribute('href') || '';
    var loc = el.getAttribute('data-track-location') || (el.closest('[data-section]') || {}).dataset?.section || 'other';
    var label = el.getAttribute('data-track-label') || (el.textContent || '').trim().slice(0, 60);
    var name = el.getAttribute('data-track');
    if (!name) {
      if (href.indexOf('tel:') === 0) name = 'click_call';
      else if (href.indexOf('wa.me') > -1 || href.indexOf('whatsapp') > -1) name = 'click_whatsapp';
      else if (/instagram|youtube|youtu\.be|tiktok/.test(href)) name = 'click_social';
    }
    if (name) window.meTrack(name, { location: loc, label: label });
  }, { capture: true });
</script>

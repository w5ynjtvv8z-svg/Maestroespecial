---
/**
 * Форма заявки.
 * При нажатии «Отправить заявку» открывается WhatsApp на номер компании
 * с уже набранным текстом заявки — клиенту остаётся нажать «Отправить».
 * Дополнительно (на Netlify) копия заявки сохраняется в Netlify Forms → lead.
 */
import Icon from './Icon.astro';
import { ui, privacyPath, type Lang } from '../lib/i18n';
import { getServices, settings } from '../lib/data';
interface Props { lang: Lang; preselect?: string }
const { lang, preselect } = Astro.props;
const t = ui[lang];
const services = getServices(lang);
---
<form
  class="lead-form card"
  name="lead"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-wa={settings.whatsapp}
  data-ok={t.formOk}
  data-blocked={t.formPopupBlocked}
  data-header={`${t.formWaHeader} ${settings.brand}`}
  data-l-name={t.formName}
  data-l-phone={t.formPhone}
  data-l-service={t.formService}
  data-l-message={t.formMessage}
>
  <h3>{t.formTitle}</h3>
  <input type="hidden" name="form-name" value="lead" />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="page" value="" />
  <p class="hp" aria-hidden="true"><label>Bot <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <label class="field">
    <span>{t.formName}</span>
    <input type="text" name="name" required autocomplete="name" />
  </label>
  <label class="field">
    <span>{t.formPhone}</span>
    <input type="tel" name="phone" required autocomplete="tel" inputmode="tel" placeholder="+34 …" />
  </label>
  <label class="field">
    <span>{t.formService}</span>
    <select name="service">
      {services.map((s) => <option value={s.title} selected={s.id === preselect}>{s.title}</option>)}
      <option value={t.formServiceOther}>{t.formServiceOther}</option>
    </select>
  </label>
  <label class="field">
    <span>{t.formMessage}</span>
    <textarea name="message" rows="3"></textarea>
  </label>
  <label class="check">
    <input type="checkbox" name="consent" value="yes" required />
    <span>{t.formConsent} <a href={privacyPath(lang)} target="_blank">{t.formConsentLink}</a></span>
  </label>
  <button type="submit" class="btn btn-wa btn-block btn-lg"><Icon name="whatsapp" /> {t.formSubmit}</button>
  <p class="form-note">{t.formWaNote}</p>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = form.dataset;
      const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement)?.value || '').trim();
      if (val('bot-field')) return; // спам-бот

      // 1) Текст заявки для WhatsApp
      const lines = [
        `*${d.header}*`,
        `${d.lName}: ${val('name')}`,
        `${d.lPhone}: ${val('phone')}`,
        `${d.lService}: ${val('service')}`,
      ];
      if (val('message')) lines.push(`${d.lMessage}: ${val('message')}`);
      const url = `https://wa.me/${d.wa}?text=${encodeURIComponent(lines.join('\n'))}`;

      // Открываем сразу (синхронно), чтобы браузер не заблокировал окно
      window.open(url, '_blank', 'noopener');

      // Запасная ссылка — на случай, если браузер не дал открыть окно
      const status = form.querySelector<HTMLElement>('.form-status')!;
      status.className = 'form-status ok';
      status.textContent = d.ok!;
      const a = document.createElement('a');
      a.href = url; a.target = '_blank'; a.rel = 'noopener';
      a.textContent = d.blocked!;
      status.append(document.createElement('br'), a);
      (window as any).meTrack?.('generate_lead', { location: 'form', label: val('service'), method: 'whatsapp' });

      // 2) Резервная копия заявки в Netlify Forms (на хостинге Netlify); ошибки игнорируем
      (form.elements.namedItem('page') as HTMLInputElement).value = location.pathname;
      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form) as any).toString(),
      }).catch(() => {});

      form.reset();
    });
  });
</script>

---
// Панель сантехника: все заявки, статусы, звонок/WhatsApp клиенту.
// Адрес: /panel/  · Вход по паролю (переменная ADMIN_PASSWORD в Netlify).
import '../../styles/global.css';
import Icon from '../../components/Icon.astro';
import { settings } from '../../lib/data';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0b0b0b" />
  <title>Заявки — {settings.brand}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body class="panel">
  <header class="p-top">
    <div class="p-wrap p-top-inner">
      <img src="/images/logo.png" alt={settings.brand} class="p-logo" width="392" height="226" />
      <strong class="p-title">Заявки</strong>
      <div class="p-top-actions" hidden>
        <button class="p-icon-btn" id="p-refresh" title="Обновить"><Icon name="refresh" size={20} /><span>Обновить</span></button>
        <a class="p-icon-btn" href="/admin/" title="Редактировать тексты сайта"><Icon name="tool" size={20} /><span>Сайт</span></a>
        <button class="p-icon-btn" id="p-logout" title="Выйти"><Icon name="close" size={20} /><span>Выйти</span></button>
      </div>
    </div>
  </header>

  <div class="p-demo" id="p-demo" hidden>
    Демо-режим: заявки хранятся только в этом браузере. Пароль: <b>demo</b>.
    Отправьте заявку на <a href="/ru/">сайте</a> — она появится здесь.
  </div>

  <!-- Вход -->
  <section id="p-login" class="p-wrap p-login" hidden>
    <form class="card">
      <h1>Вход в панель заявок</h1>
      <label class="field">
        <span>Пароль</span>
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button class="btn btn-red btn-block btn-lg" type="submit">Войти</button>
      <p class="form-status err" hidden></p>
    </form>
  </section>

  <!-- Заявки -->
  <main id="p-app" class="p-wrap" hidden>
    <nav class="p-tabs" role="tablist">
      <button data-tab="new" class="active">Новые <b data-count="new">0</b></button>
      <button data-tab="accepted">Принятые <b data-count="accepted">0</b></button>
      <button data-tab="done">Выполненные <b data-count="done">0</b></button>
      <button data-tab="rejected">Отказ <b data-count="rejected">0</b></button>
      <button data-tab="all">Все <b data-count="all">0</b></button>
    </nav>
    <input type="search" id="p-search" class="p-search" placeholder="Поиск: имя, телефон, услуга, № заявки" />
    <p class="p-updated muted" id="p-updated"></p>
    <div id="p-list" class="p-list"></div>
  </main>

  <script>
    import { adminLogin, adminList, adminUpdate, adminDelete, isDemo, ApiError, type AdminLead, type Status } from '../../lib/api';

    const TOKEN_KEY = 'me-admin-token';
    const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const loginEl = $('#p-login');
    const appEl = $('#p-app');
    const listEl = $('#p-list');
    const actionsEl = $('.p-top-actions');
    let token = '';
    try { token = localStorage.getItem(TOKEN_KEY) || ''; } catch {}
    let leads: AdminLead[] = [];
    let tab: Status | 'all' = 'new';
    let query = '';

    if (isDemo) $('#p-demo').hidden = false;

    const STATUS: Record<Status, string> = { new: 'Новая', accepted: 'Принята', done: 'Выполнена', rejected: 'Отказ' };
    const LANG: Record<string, string> = { es: '🇪🇸 испанский', ru: '🇷🇺 русский', en: '🇬🇧 английский' };
    const GREET: Record<string, string> = {
      es: 'Hola, le escribe el técnico de Maestro Especial sobre su solicitud nº',
      ru: 'Здравствуйте! Это мастер Maestro Especial по вашей заявке №',
      en: 'Hello, this is the technician from Maestro Especial about your request No.',
    };
    const ACTIONS: Record<Status, [Status, string, string][]> = {
      new: [['accepted', 'Принять', 'btn-red'], ['rejected', 'Отказ', 'btn-outline']],
      accepted: [['done', 'Выполнено ✓', 'btn-wa'], ['new', 'Вернуть в новые', 'btn-outline'], ['rejected', 'Отказ', 'btn-outline']],
      done: [['accepted', 'Вернуть в работу', 'btn-outline']],
      rejected: [['new', 'Вернуть в новые', 'btn-outline']],
    };

    const esc = (s = '') => String(s).replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    const fmt = (iso: string) => new Date(iso).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    const ago = (iso: string) => {
      const m = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
      if (m < 1) return 'только что';
      if (m < 60) return `${m} мин назад`;
      const h = Math.round(m / 60);
      if (h < 24) return `${h} ч назад`;
      return fmt(iso);
    };
    const telDigits = (p: string) => p.replace(/[^\d+]/g, '');
    const waDigits = (p: string) => {
      let d = p.replace(/\D/g, '').replace(/^00/, '');
      if (d.length === 9 && /^[6789]/.test(d)) d = '34' + d; // испанский номер без кода страны
      return d;
    };

    function showLogin() {
      loginEl.hidden = false;
      appEl.hidden = true;
      actionsEl.hidden = true;
      loginEl.querySelector<HTMLInputElement>('input')!.focus();
    }
    function showApp() {
      loginEl.hidden = true;
      appEl.hidden = false;
      actionsEl.hidden = false;
    }

    async function load() {
      try {
        leads = await adminList(token);
        showApp();
        render();
        $('#p-updated').textContent = `Обновлено: ${new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}`;
      } catch (e) {
        if (e instanceof ApiError && e.status === 401) {
          token = '';
          try { localStorage.removeItem(TOKEN_KEY); } catch {}
          showLogin();
        } else {
          $('#p-updated').textContent = 'Нет связи с сервером. Повторим через 30 секунд.';
        }
      }
    }

    function render() {
      const counts: Record<string, number> = { new: 0, accepted: 0, done: 0, rejected: 0, all: leads.length };
      leads.forEach((l) => counts[l.status]++);
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => (el.textContent = String(counts[el.dataset.count!])));
      document.title = (counts.new ? `(${counts.new}) ` : '') + 'Заявки — Maestro Especial';

      const q = query.toLowerCase();
      const shown = leads.filter(
        (l) =>
          (tab === 'all' || l.status === tab) &&
          (!q || [l.id, l.name, l.phone, l.service, l.message].join(' ').toLowerCase().includes(q)),
      );

      if (!shown.length) {
        listEl.innerHTML = `<div class="card empty"><p>${tab === 'new' && !q ? 'Новых заявок нет 👍' : 'Здесь пока пусто'}</p></div>`;
        return;
      }

      listEl.innerHTML = shown
        .map((l) => {
          const wa = `https://wa.me/${waDigits(l.phone)}?text=${encodeURIComponent(`${GREET[l.lang] || GREET.es} ${l.id}`)}`;
          const history = (l.history || []).map((h) => `<li>${fmt(h.at)} — ${STATUS[h.status]}</li>`).join('');
          return `<article class="lead card lead-${l.status}" data-id="${l.id}">
            <div class="lead-head">
              <span class="lead-no">№ ${esc(l.id)}</span>
              <span class="pill pill-${l.status}">${STATUS[l.status]}</span>
              <time title="${fmt(l.createdAt)}">${ago(l.createdAt)}</time>
            </div>
            <h2 class="lead-name">${esc(l.name)}</h2>
            <a class="lead-phone" href="tel:${esc(telDigits(l.phone))}">${esc(l.phone)}</a>
            <div class="lead-contact">
              <a class="btn btn-dark" href="tel:${esc(telDigits(l.phone))}">📞 Позвонить</a>
              <a class="btn btn-wa" href="${esc(wa)}" target="_blank" rel="noopener">WhatsApp</a>
            </div>
            <p class="lead-service">🔧 ${esc(l.service)}</p>
            ${l.message ? `<p class="lead-msg">${esc(l.message)}</p>` : ''}
            <p class="lead-meta">${LANG[l.lang] || esc(l.lang)}${l.page ? ` · страница ${esc(l.page)}` : ''}</p>
            <div class="lead-actions">
              ${ACTIONS[l.status].map(([s, label, cls]) => `<button class="btn ${cls}" data-status="${s}">${label}</button>`).join('')}
            </div>
            <details class="lead-more">
              <summary>Заметка и история</summary>
              <label class="field"><span>Заметка (видна только вам)</span>
                <textarea rows="2" data-note>${esc(l.note || '')}</textarea>
              </label>
              <ul class="lead-history">${history}</ul>
              <button class="link-btn lead-del" data-delete>Удалить заявку</button>
            </details>
          </article>`;
        })
        .join('');
    }

    async function update(id: string, patch: { status?: Status; note?: string }) {
      try {
        const updated = await adminUpdate(token, id, patch);
        leads = leads.map((l) => (l.id === id ? updated : l));
        render();
      } catch {
        alert('Не удалось сохранить. Проверьте интернет и попробуйте ещё раз.');
      }
    }

    // ---- События ----
    loginEl.querySelector('form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const err = form.querySelector<HTMLElement>('.form-status')!;
      err.hidden = true;
      try {
        token = await adminLogin((form.elements.namedItem('password') as HTMLInputElement).value);
        try { localStorage.setItem(TOKEN_KEY, token); } catch {}
        form.reset();
        load();
      } catch (ex) {
        err.textContent =
          ex instanceof ApiError && ex.status === 401
            ? 'Неверный пароль'
            : ex instanceof ApiError && ex.status === 503
              ? 'Пароль панели ещё не задан на сервере (ADMIN_PASSWORD).'
              : 'Нет связи с сервером';
        err.hidden = false;
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) =>
      b.addEventListener('click', () => {
        tab = b.dataset.tab as typeof tab;
        document.querySelectorAll('[data-tab]').forEach((x) => x.classList.toggle('active', x === b));
        render();
      }),
    );
    $<HTMLInputElement>('#p-search').addEventListener('input', (e) => {
      query = (e.target as HTMLInputElement).value;
      render();
    });
    $('#p-refresh').addEventListener('click', load);
    $('#p-logout').addEventListener('click', () => {
      token = '';
      try { localStorage.removeItem(TOKEN_KEY); } catch {}
      showLogin();
    });

    listEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const card = target.closest<HTMLElement>('.lead');
      if (!card) return;
      const id = card.dataset.id!;
      const statusBtn = target.closest<HTMLButtonElement>('[data-status]');
      if (statusBtn) update(id, { status: statusBtn.dataset.status as Status });
      if (target.closest('[data-delete]') && confirm(`Удалить заявку № ${id}? Это нельзя отменить.`)) {
        adminDelete(token, id).then(() => {
          leads = leads.filter((l) => l.id !== id);
          render();
        });
      }
    });
    listEl.addEventListener('change', (e) => {
      const ta = e.target as HTMLTextAreaElement;
      if (ta.matches('[data-note]')) update(ta.closest<HTMLElement>('.lead')!.dataset.id!, { note: ta.value });
    });

    // Автообновление каждые 30 секунд (пока вкладка открыта)
    setInterval(() => { if (token && !document.hidden) load(); }, 30000);
    document.addEventListener('visibilitychange', () => { if (token && !document.hidden) load(); });

    if (token) load();
    else showLogin();
  </script>

  <style is:global>
    body.panel { background: var(--bg-soft); padding-bottom: 40px; }
    .p-wrap { max-width: 900px; margin: 0 auto; padding: 0 12px; }
    .p-top { background: var(--black); color: #fff; border-bottom: 2px solid var(--gold); position: sticky; top: 0; z-index: 10; }
    .p-top-inner { display: flex; align-items: center; gap: 12px; height: 60px; }
    .p-logo { height: 42px; width: auto; }
    .p-title { font-size: 1.15rem; }
    .p-top-actions { margin-left: auto; display: flex; gap: 6px; }
    .p-top-actions[hidden] { display: none; }
    .p-icon-btn { display: inline-flex; align-items: center; gap: 6px; background: #1d1d22; color: #fff; border: 0; border-radius: 10px; padding: 8px 10px; font: inherit; font-size: .9rem; text-decoration: none; cursor: pointer; }
    .p-icon-btn:hover { background: #2a2a31; }
    @media (max-width: 560px) { .p-icon-btn span { display: none; } }
    .p-demo { background: #fff1d6; color: #6b4600; padding: 10px 16px; text-align: center; font-size: .92rem; }
    .p-login { padding-top: 40px; max-width: 420px; }
    .p-login h1 { font-size: 1.4rem; }
    .p-tabs { display: flex; gap: 6px; overflow-x: auto; padding: 14px 0 10px; scrollbar-width: none; }
    .p-tabs button { flex: none; border: 1.5px solid var(--line); background: #fff; border-radius: 999px; padding: 8px 14px; font: inherit; font-weight: 600; cursor: pointer; color: var(--text); }
    .p-tabs button b { display: inline-block; min-width: 22px; padding: 0 6px; margin-left: 4px; border-radius: 999px; background: var(--bg-soft); font-size: .85rem; }
    .p-tabs button.active { background: var(--black); color: #fff; border-color: var(--black); }
    .p-tabs button.active b { background: var(--gold); color: var(--black); }
    .p-search { width: 100%; font: inherit; font-size: 16px; padding: 11px 14px; border: 1.5px solid var(--line); border-radius: 12px; }
    .p-updated { font-size: .82rem; margin: 8px 2px; }
    .p-list { display: grid; gap: 12px; }
    .lead { padding: 18px; border-left: 5px solid var(--line); }
    .lead-new { border-left-color: var(--red); }
    .lead-accepted { border-left-color: #2563eb; }
    .lead-done { border-left-color: var(--wa); }
    .lead-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: .9rem; }
    .lead-no { font-weight: 800; letter-spacing: .03em; }
    .lead-head time { margin-left: auto; color: var(--muted); }
    .lead-name { font-size: 1.3rem; margin: 10px 0 2px; }
    .lead-phone { font-size: 1.15rem; font-weight: 700; color: var(--red); text-decoration: none; }
    .lead-contact { display: flex; gap: 8px; margin: 12px 0; flex-wrap: wrap; }
    .lead-contact .btn { padding: .6em 1.1em; }
    .lead-service { font-weight: 600; margin: 0 0 6px; }
    .lead-msg { background: var(--bg-soft); border-radius: 10px; padding: 10px 12px; margin: 0 0 8px; white-space: pre-wrap; }
    .lead-meta { color: var(--muted); font-size: .85rem; margin: 0 0 12px; }
    .lead-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .lead-actions .btn { padding: .65em 1.3em; }
    .lead-actions .btn-outline { color: var(--muted); border-color: var(--line); }
    .lead-more { margin-top: 12px; border-top: 1px solid var(--line); padding-top: 10px; }
    .lead-more summary { cursor: pointer; color: var(--muted); font-size: .9rem; }
    .lead-more .field { margin-top: 10px; }
    .lead-history { font-size: .85rem; color: var(--muted); padding-left: 18px; }
    .lead-del { color: var(--red); font-size: .85rem; }
  </style>
</body>
</html>
